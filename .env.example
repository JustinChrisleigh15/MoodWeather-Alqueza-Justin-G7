# Copy this file to .env and fill in real values. NEVER commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (local) or Supabase (Project Settings > Database > Connection info)
DB_NAME=moodweather
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
# Use "require" for Supabase, "prefer" for local PostgreSQL
DB_SSLMODE=prefer
